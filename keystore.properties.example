# Copy to keystore.properties in this folder (ignored by git).
# Paths are relative to the project root.
#
# Play Console uses Play App Signing: you keep an *upload* key here; Google re-signs for users.
# After the first upload, register your app signing certificate SHA-1/256 in Firebase for Google Sign-In.
storeFile=path/to/upload-key.jks
storePassword=
keyAlias=
keyPassword=
